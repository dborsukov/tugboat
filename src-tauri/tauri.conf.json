{
  "$schema": "https://schema.tauri.app/config/2",
  "version": "0.1.0",
  "app": {
    "windows": [
      {
        "title": "Папай CRM",
        "width": 1280,
        "height": 720,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#fbfaf7",
        "visible": false,
        "create": false
      },
      {
        "label": "splashscreen",
        "title": "Папай CRM",
        "url": "splashscreen.html",
        "width": 420,
        "height": 300,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "shadow": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "create": false,
        "backgroundColor": "#fbfaf700"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "style-src-attr": "'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    },
    "withGlobalTauri": true
  },
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzNzUzMjY1QjYyNzY2MDkKUldRSlppZTJaVEoxSTkzOWFLNGdvcm83alhaN3FBVDcwb05EbWtUSjJBbXNoekV1ckdncEFXMVEK",
      "endpoints": [
        "https://github.com/dborsukov/tugboat/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "identifier": "com.popeye.crm",
  "productName": "popeyecrm"
}
