{
  "$schema": "https://schema.tauri.app/config/2",
  "version": "0.1.0",
  "app": {
    "windows": [
      {
        "title": "Папай CRM",
        "width": 1280,
        "height": 720,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#fbfaf7",
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "Папай CRM",
        "url": "splashscreen.html",
        "width": 420,
        "height": 300,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "shadow": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "backgroundColor": "#fbfaf700"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "identifier": "com.popeye.crm",
  "productName": "popeyecrm"
}
